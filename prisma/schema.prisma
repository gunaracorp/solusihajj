// ============================================================
// SolusiHajj R2 — "Fondasi Data Nasional"
// Database marketplace dengan data RIIL hasil penarikan dari
// situs resmi: Kemenag, Kementerian Haji & Umrah (Kemenhaj),
// SISKOPATUH, Satu Data Kemenag, Saudi MOHU, Kemenparekraf,
// HIMPUH, Kemenag Jatim, dan situs resmi maskapai.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- SUMBER DATA & PIPELINE SINKRONISASI ----------

/// Sumber data resmi yang dipantau pipeline R2
model DataSource {
  id             String      @id @default(cuid())
  key            String      @unique // "kemenag", "kemenhaj", ...
  name           String // "Sistem Informasi Izin Umrah (SIMPU)"
  institution    String // "Kementerian Agama RI"
  url            String
  category       String // KEMENTERIAN | LEMBAGA | ASOSIASI | MASKAPAI | INTERNASIONAL
  country        String      @default("ID")
  description    String
  recordsIndexed Int         @default(0)
  lastSyncedAt   DateTime?
  syncEvents     SyncEvent[]
  companies      Company[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

/// Log setiap proses sinkronisasi (audit trail — prinsip Amanah)
model SyncEvent {
  id              String     @id @default(cuid())
  sourceId        String
  source          DataSource @relation(fields: [sourceId], references: [id])
  status          String // SUCCESS | FAILED | RUNNING
  recordsAffected Int        @default(0)
  note            String?
  startedAt       DateTime   @default(now())
  finishedAt      DateTime?
}

// ---------- PENYELENGGARA (PPIU / PIHK / BPW / KBIHU) ----------

/// Perusahaan penyelenggara ibadah — data riil dari sumber resmi
model Company {
  id           String    @id @default(cuid())
  name         String // "PT. Al Ahram Sarana Wisata"
  brandName    String? // "AL AHRAM"
  orgType      String // PPIU | PIHK | BPW | KBIHU | PENERBANGAN_PARTNER
  licenseNo    String? // "KMA Nomor 785 Tahun 2017" / "TUPU ..."
  licenseYear  Int?
  leader       String?
  address      String?
  city         String?
  province     String?
  country      String    @default("ID") // ISO-2; MY/SG/BN/TH/SA untuk Asia
  phone        String?
  email        String?
  website      String?
  status       String    @default("AKTIF") // AKTIF | BARU | SANKSI | KURASI
  tier         String? // Platinum | Gold | Silver (hanya partner terkurasi)
  verified     Boolean   @default(false)
  sourceId     String?
  source       DataSource? @relation(fields: [sourceId], references: [id])
  sourceRef    String? // URL halaman sumber tempat data ditarik
  dataAsOf     String? // "Mei 2025" — kebaruan data saat ditarik
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  escrowContracts EscrowContract[]

  @@unique([name, orgType])
  @@index([orgType])
  @@index([province])
  @@index([country])
  @@index([status])
}

/// Catatan sanksi/teguran dari otoritas (transparansi kepercayaan)
model SanctionRecord {
  id           String   @id @default(cuid())
  companyName  String
  province     String?
  authority    String // "Kemenag Jawa Timur"
  sanctionType String // Teguran | Pembekuan | Pencabutan
  year         Int
  sourceUrl    String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([companyName])
}

/// Regulasi yang menjadi dasar hukum industri (konten SEO + edukasi)
model GovRegulation {
  id          String @id @default(cuid())
  title       String
  number      String // "UU 14/2025"
  year        Int
  institution String
  kind        String // UU | PMHU | PMA | KEPPRES
  url         String?
  summary     String

  @@unique([number, title])
}

// ---------- MASKAPAI & RUTE (Jaringan Transportasi Ibadah) ----------

/// Maskapai yang melayani jamaah haji & umrah
model Airline {
  id       String        @id @default(cuid())
  name     String
  iata     String        @unique // GA, SV, JT, QG, IU, MS, TK
  icao     String?
  country  String        @default("ID")
  category String // PEMERINTAH_HAJI | REGULER | CHARTER_UMRAH
  hub      String?
  notes    String?
  active   Boolean       @default(true)
  routes   FlightRoute[]
}

/// Rute penerbangan jamaah (reguler/charter umrah/charter haji)
model FlightRoute {
  id          String  @id @default(cuid())
  airlineId   String
  airline     Airline @relation(fields: [airlineId], references: [id])
  originCity  String
  originCode  String // CGK, SUB, KNO, ...
  destCity    String
  destCode    String // JED, MED
  destCountry String  @default("SA")
  freqText    String? // "8x/minggu", "Musiman"
  aircraft    String? // "A330-300", "B777-300ER"
  seats       Int?
  serviceType String // REGULER | CHARTER_UMRAH | CHARTER_HAJI
  sinceText   String? // "13 Juli 2025"
  notes       String?

  @@index([airlineId])
}

// ============================================================
// R3 — "AMANAH ESCROW AKTIF + NURMATCH AI"
// ============================================================

/// Kontrak escrow jamaah ↔ penyelenggara (dana ditahan pihak ketiga)
model EscrowContract {
  id             String   @id @default(cuid())
  ref            String   @unique // "SH-ESC-2026-00001"
  jamaahName     String
  jamaahPhone    String?
  jamaahEmail    String?
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  packageTitle   String
  departDate     String?
  paxCount       Int      @default(1)
  currency       String   @default("IDR")
  totalAmount    Int // total harga paket (rupiah)
  status         String   @default("DRAFT") // DRAFT | FUNDED | PARTIAL_RELEASE | SETTLED | DISPUTED | REFUNDED | CANCELLED
  fundedAmount   Int      @default(0)
  releasedAmount Int      @default(0)
  depositRef     String?
  note           String?
  milestones     EscrowMilestone[]
  events         EscrowEvent[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

/// Milestone rilis dana skema Amanah 40/40/20
model EscrowMilestone {
  id         String          @id @default(cuid())
  contractId String
  contract   EscrowContract  @relation(fields: [contractId], references: [id])
  seq        Int // 1..3
  label      String // "Rilis 1 — Visa & tiket terbit", ...
  percent    Int // 40 | 40 | 20
  amount     Int
  status     String          @default("HELD") // HELD | RELEASED | DISPUTED | REFUNDED
  trigger    String // syarat rilis
  actedAt    DateTime?
  note       String?

  @@unique([contractId, seq])
}

/// Audit trail escrow (prinsip Saksi Jamaah — setiap aksi tercatat)
model EscrowEvent {
  id         String         @id @default(cuid())
  contractId String
  contract   EscrowContract @relation(fields: [contractId], references: [id])
  actor      String // JAMAAH | PLATFORM | OPERATOR | DUAL_CONTROL
  action     String // CREATED | FUNDED | RELEASE_REQUESTED | RELEASED | DISPUTED | REFUNDED | RESOLVED | NOTE
  detail     String
  createdAt  DateTime       @default(now())

  @@index([contractId])
}

/// Sesi rekomendasi NurMatch AI (LLM) — profil jamaah → paket/PPIU
model AiMatchSession {
  id         String   @id @default(cuid())
  profile    String // JSON profil: budget, kota, bulan, pax, gaya, prioritas
  verdict    String? // kesimpulan 1 kalimat
  reasoning  String? // penjelasan AI (markdown)
  packageIds String? // JSON array paket yang direkomendasikan
  companyIds String? // JSON array penyelenggara yang direkomendasikan
  followUps  String? // JSON pertanyaan lanjutan
  model      String?
  latencyMs  Int?
  createdAt  DateTime @default(now())
}
